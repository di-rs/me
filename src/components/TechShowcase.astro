---
import TechCard from "./TechCard.astro";
import YearsHighlight from "./YearsHighlight.astro";
import { techShowcase } from "../content/siteData";

const { title, startYear, titleSuffix, subtitle, techStacks } = techShowcase;
---

<section
  class="tech-showcase relative min-h-screen flex items-center justify-center py-40 pb-16 md:py-40 md:pb-16 opacity-0 translate-y-10 px-6 md:px-12"
>
  <div class="w-full container mx-auto text-center px-8">
    <h2
      class="text-[2rem] md:text-5xl lg:text-[3.5rem] font-bold text-primary mb-6 leading-[1.3]"
    >
      {title}
      <YearsHighlight startYear={startYear} />
      {titleSuffix}
    </h2>
    <p
      class="text-lg md:text-xl lg:text-2xl text-muted-foreground mb-12 md:mb-20 font-normal"
    >
      {subtitle}
    </p>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-7 lg:gap-8 w-full"
    >
      {techStacks.map((tech) => <TechCard technologies={tech.technologies} />)}
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tech-showcase {
    animation: fadeInUp 0.8s ease-out 0.2s forwards;
  }
</style>
