---
import TechCard from "./TechCard.vue";
import TextHighlight from "./TextHighlight.vue";

const techStacks = [
  {
    id: 1,
    technologies: ["React", "Next.js", "Vue.js", "Svelte", "Astro"],
  },
  {
    id: 2,
    technologies: ["TypeScript", "Node.js", "Bun", "Nitro", "Nuxt.js"],
  },
  {
    id: 3,
    technologies: [
      "Tailwind CSS",
      "Framer Motion",
      "UI Kits",
      "AI Agents",
      "Remix",
    ],
  },
  {
    id: 4,
    technologies: [
      "Design Systems",
      "AI",
      "Microfrontends",
      "Frontend Architecture",
      "MCPs",
    ],
  },
];
---

<div
  class="tech-showcase relative min-h-screen flex items-center justify-center px-6 py-40 pb-16 md:px-12 md:py-[10rem] md:pb-16 opacity-0 translate-y-10"
>
  <div class="w-full max-w-7xl mx-auto text-center">
    <h2
      class="text-[2rem] md:text-5xl lg:text-[3.5rem] font-bold text-text-primary mb-6 leading-[1.3]"
    >
      I am an experienced developer with
      <TextHighlight text="8 years" client:visible />
      of experience
    </h2>
    <p
      class="text-lg md:text-xl lg:text-2xl text-text-secondary mb-12 md:mb-20 font-normal"
    >
      High proficiency in the following technologies
    </p>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-7 lg:gap-8 w-full max-w-[1200px] mx-auto px-8"
    >
      {
        techStacks.map((tech) => (
          <TechCard
            technologies={tech.technologies}
            delay={tech.id * 200}
            client:visible
          />
        ))
      }
    </div>
  </div>
</div>

<style>
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .tech-showcase {
    animation: fadeInUp 0.8s ease-out 0.2s forwards;
  }
</style>
