---
import BlurReveal from "./ui/BlurReveal.vue";
import ShimmerButton from "./ui/ShimmerButton.vue";
import { getEntry } from "astro:content";

const hero = await getEntry("hero", "hero");
if (!hero) throw new Error("Hero content not found");

const social = await getEntry("social", "social");
if (!social) throw new Error("Social content not found");
---

<div class="flex flex-col gap-8">
  <BlurReveal client:only="vue" delay={0.2} duration={0.75} class="space-y-6">
    <h1 class="text-5xl md:text-6xl font-bold text-primary pb-3">
      {hero.data.greeting}
    </h1>
    <p class="text-xl text-muted-foreground leading-relaxed text-balance">
      {hero.data.description}
    </p>
  </BlurReveal>

  <div class="flex flex-wrap gap-4">
    <ShimmerButton
      client:only="vue"
      variant="primary"
      href={hero.data.cta1Link}
      download={hero.data.cta1Download}
    >
      {hero.data.cta1Label}
    </ShimmerButton>
    <ShimmerButton
      client:only="vue"
      variant="secondary"
      href={social.data.linkedin}
    >
      {hero.data.cta2Label}
    </ShimmerButton>
  </div>
</div>
