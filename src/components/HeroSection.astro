---
import BlurReveal from "./ui/BlurReveal.vue";
import ShimmerButton from "./ui/ShimmerButton.vue";
import { hero, social } from "../content/siteData";
---

<div class="flex flex-col gap-8">
  <BlurReveal client:only="vue" delay={0.2} duration={0.75} class="space-y-6">
    <h1 class="text-5xl md:text-6xl font-bold text-text-primary pb-3">
      {hero.greeting}
    </h1>
    <p class="text-xl text-text-secondary leading-relaxed text-balance">
      {hero.description}
    </p>
  </BlurReveal>

  <div class="flex flex-wrap gap-4">
    <ShimmerButton
      client:only="vue"
      variant="primary"
      href="https://drive.google.com/uc?export=download&id=17-z7Vpdw0bRPproFqa6HorcKx-otFV1e"
      download="Dmitriy_Popov_CV.pdf"
    >
      {hero.cta.primary}
    </ShimmerButton>
    <ShimmerButton client:only="vue" variant="secondary" href={social.linkedin}>
      {hero.cta.secondary}
    </ShimmerButton>
  </div>
</div>
