---
import Layout from "@/layouts/Layout.astro";
import { getEntry } from "astro:content";
import AnimatedListItem from "@/components/AnimatedListItem.astro";

const aboutEntry = await getEntry("about", "about");
if (!aboutEntry) throw new Error("About content not found");

const { Content } = await aboutEntry.render();
---

<Layout
  title="Dima Portfolio | About"
  description="Learn more about my skills, expertise, and professional background in software engineering and web development."
>
  <section class="relative w-full flex-1 container mx-auto flex">
    <div
      class="max-w-[1200px] flex-1 mx-auto px-8 md:px-16 w-full flex items-center"
    >
      <div class="about-content">
        <Content components={{ li: AnimatedListItem }} />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Custom list styling */
  .about-content :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Reduce motion for accessibility */
  @media (prefers-reduced-motion: reduce) {
    .about-content :global(*) {
      animation: none !important;
      transition: none !important;
      opacity: 1 !important;
    }
  }
</style>
