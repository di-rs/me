---
import Layout from "@/layouts/Layout.astro";
import ExperienceTimeline from "@/components/ExperienceTimeline.vue";
---

<Layout
  title="Dima Portfolio | Experience"
  description="Explore my professional journey, work experience, and achievements in software engineering and web development."
>
  <div class="relative w-full p-0 bg-bg-primary min-h-screen">
    <!-- Section Header -->
    <div class="text-center mb-6 px-8 pt-4">
      <h2 class="text-3xl md:text-4xl font-extrabold text-text-primary mb-1 tracking-tight">
        Experience
      </h2>
      <p class="text-[0.9375rem] text-text-secondary font-normal">
        My professional journey
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative max-w-[1200px] mx-auto px-4 md:px-16 py-8 min-h-screen">
      <ExperienceTimeline client:only="vue" />
    </div>
  </div>
</Layout>
