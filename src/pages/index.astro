---
import Layout from "@/layouts/Layout.astro";
import HeroSection from "@/components/HeroSection.astro";
import ProfileCanvas from "@/components/effects/ProfileCanvas.vue";
import TechShowcase from "@/components/TechShowcase.astro";
---

<Layout>
  <div id="smooth-wrapper" class="-mt-24 -mb-12 relative z-1">
    <div id="smooth-content" class="relative">
      <section
        class="relative min-h-dvh flex items-center justify-center z-[1] px-6 md:px-12"
      >
        <div
          class="grid md:grid-cols-2 gap-12 items-center max-w-7xl mx-auto w-full"
        >
          <div class="flex justify-center">
            <ProfileCanvas client:only="vue" />
          </div>

          <HeroSection />
        </div>
      </section>

      <section class="relative z-1 container mx-auto px-2">
        <TechShowcase />
      </section>
    </div>
  </div>
</Layout>

<script>
  import Lenis from "lenis";

  const lenis = new Lenis({
    duration: 1.2,
    easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: "vertical",
    gestureOrientation: "vertical",
    smoothWheel: true,
    wheelMultiplier: 1,
    touchMultiplier: 2,
    infinite: false,
  });

  function raf(time: number) {
    lenis.raf(time);
    requestAnimationFrame(raf);
  }

  requestAnimationFrame(raf);
</script>
