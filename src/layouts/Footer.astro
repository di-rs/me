---
import MetallicBorder from "../components/ui/MetallicBorder.vue";
import { baseData, social } from "../content/siteData";
import Github from "@/components/icons/Github.astro";
import Linkedin from "@/components/icons/Linkedin.astro";
import Email from "@/components/icons/Email.astro";

const socialList = [
  {
    href: social.github,
    icon: Github,
    label: "GitHub",
  },
  {
    href: social.linkedin,
    icon: Linkedin,
    label: "LinkedIn",
  },
  {
    href: social.email,
    icon: Email,
    label: "Email",
  },
];
---

<footer class="py-8 border-t border-border-subtle mt-auto relative z-10">
  <MetallicBorder client:only="vue" position="top" delay={2} />
  <div class="px-6 md:px-24 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-xs text-neutral-700">
        &copy; <span id="copyright-year"
          >{new Date().getFullYear().toString()}</span
        >
        {baseData.author}
      </div>

      <div class="flex items-center gap-6">
        {
          socialList.map(({ href, icon: Icon, label }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-neutral-700 hover:text-muted-foreground transition-all"
              aria-label={label}
            >
              <Icon width={20} height={20} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const copyrightYear = document.getElementById("copyright-year");
  if (copyrightYear) {
    copyrightYear.textContent = new Date().getFullYear().toString();
  }
</script>
