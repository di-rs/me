---
import MetallicBorder from "../components/ui/MetallicBorder.vue";
import { baseData, social } from "../content/siteData";
import { Image } from "astro:assets";
import githubIcon from "../assets/github.svg";
import linkedinIcon from "../assets/linkedin.svg";
import emailIcon from "../assets/email.svg";
---

<footer class="py-8 border-t border-border-subtle mt-auto relative z-10">
  <MetallicBorder client:only="vue" position="top" delay={2} />
  <div class="px-6 md:px-24 max-w-7xl mx-auto">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="text-xs text-text-muted opacity-60">
        &copy; <span id="copyright-year"
          >{new Date().getFullYear().toString()}</span
        >
        {baseData.author}
      </div>

      <div class="flex items-center gap-6">
        <a
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted opacity-50 hover:opacity-100 hover:text-text-secondary transition-all"
          aria-label="GitHub"
        >
          <Image src={githubIcon} alt="GitHub" width={20} />
        </a>

        <a
          href={social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted opacity-50 hover:opacity-100 hover:text-text-secondary transition-all"
          aria-label="LinkedIn"
        >
          <Image src={linkedinIcon} alt="LinkedIn" height={20} />
        </a>

        <a
          href={social.email}
          class="text-text-muted opacity-50 hover:opacity-100 hover:text-text-secondary transition-all"
          aria-label="Email"
        >
          <Image src={emailIcon} alt="Email" width={20} />
        </a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  const copyrightYear = document.getElementById("copyright-year");
  if (copyrightYear) {
    copyrightYear.textContent = new Date().getFullYear().toString();
  }
</script>
