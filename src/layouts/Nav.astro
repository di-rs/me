---
import { social } from "../content/siteData";

const githubIconPath =
  "M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z";
---

<div
  class="fixed top-0 left-0 right-0 px-3 py-6 md:px-6 z-9999 pointer-events-none"
>
  <nav
    class="max-w-6xl mx-auto relative rounded-3xl border border-border-muted bg-bg-primary/90 backdrop-blur-[32px] backdrop-saturate-[180%] shadow-[0_8px_32px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.08)] before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-border-subtle/60 before:to-transparent before:pointer-events-none pointer-events-auto"
  >
    <ul class="px-6 md:px-8 py-4 list-none items-center flex gap-6 md:gap-8">
      <li class="mr-auto">
        <a
          href="/"
          class="flex items-center gap-2 text-text-primary hover:opacity-80 transition-opacity"
        >
          <img
            src="/favicon.svg"
            width={28}
            height={28}
            alt="Logo"
            class="opacity-90"
          />
        </a>
      </li>

      <li>
        <a
          href="/portfolio"
          class="text-sm text-text-secondary hover:text-text-primary transition-colors"
          >Portfolio</a
        >
      </li>

      <li>
        <span class="text-sm text-text-muted cursor-not-allowed"
          >Chat w/ Dima</span
        >
      </li>

      <li>
        <a
          href={social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-secondary hover:text-text-primary transition-colors"
          aria-label="GitHub"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path fill-rule="evenodd" d={githubIconPath} clip-rule="evenodd"
            ></path>
          </svg>
        </a>
      </li>

      <!-- <li>
        <a class="text-sm text-text-secondary hover:text-text-primary transition-colors" href="http://code.dimaportish.com">Beauty Of Code</a>
      </li> -->
    </ul>
  </nav>
</div>
