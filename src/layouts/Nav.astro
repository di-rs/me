---
import { Image } from "astro:assets";
---

<div
  class="fixed top-0 left-0 right-0 px-3 py-6 md:px-6 z-nav pointer-events-none"
>
  <nav
    class="max-w-6xl mx-auto relative rounded-3xl border border-border-muted bg-primary-foreground/90 backdrop-blur-[32px] backdrop-saturate-180 shadow-[0_8px_32px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.08)] before:absolute before:inset-x-0 before:top-0 before:h-px before:bg-gradient-to-r before:from-transparent before:via-border-subtle/60 before:to-transparent before:pointer-events-none pointer-events-auto"
  >
    <ul class="px-6 md:px-8 py-4 list-none items-center flex gap-6 md:gap-8">
      <li class="mr-auto">
        <a
          href="/"
          class="flex items-center gap-2 text-primary hover:opacity-80 transition-opacity"
        >
          <Image
            src="/favicon.svg"
            width={28}
            height={28}
            alt="Logo"
            class="opacity-90"
          />
        </a>
      </li>

      <li>
        <a
          href="/portfolio"
          class="text-sm text-muted-foreground hover:text-primary transition-colors"
          >Experience</a
        >
      </li>

      <li>
        <a
          href="/about"
          class="text-sm text-muted-foreground hover:text-primary transition-colors"
          >About</a
        >
      </li>

      <li>
        <span class="text-sm text-muted cursor-not-allowed">Chat w/ Dima</span>
      </li>
    </ul>
  </nav>
</div>
