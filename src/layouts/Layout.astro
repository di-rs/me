---
import "../styles/global.css";
import BaseHead from "./BaseHead.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";
import CanvasBackground from "@/components/effects/CanvasBackground.vue";

interface Props {
  title?: string;
  description?: string;
}
---

<!doctype html>
<html lang="en" data-theme="dark" class="lenis lenis-smooth">
  <BaseHead {...Astro.props} />
  <body
    class="bg-bg-primary text-text-primary relative overflow-x-hidden min-h-screen flex flex-col"
  >
    <CanvasBackground client:only="vue" />
    <Nav />
    <main class="flex-1 pt-24 pb-12 relative z-(--z-index-content) flex flex-col items-center w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
