---
import "../styles/global.css";
import BaseHead from "./BaseHead.astro";
import Footer from "./Footer.astro";
import Nav from "./Nav.astro";

interface Props {
  title?: string;
  description?: string;
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <BaseHead {...Astro.props} />
  <body class="bg-gray-9">
    <Nav />
    <main class="grid gap-8 items-start">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  const root = document.querySelector(":root") as HTMLElement | undefined;

  if (root) {
    function getRandomItem<T>(arr: readonly T[]): T {
      const index = Math.floor(Math.random() * arr.length);
      return arr[index]!;
    }

    function getRandomColor(): `${(typeof randomColor)[number]}-${(typeof randomNumber)[number]}` {
      const randomColor = [
        "red",
        "pink",
        "teal",
        "sky",
        "indigo",
        "yellow",
        "purple",
        "lime",
      ];
      const randomNumber = [3, 4, 5, 6, 7, 8, 9, 10, 11];
      const color = getRandomItem(randomColor);
      const number = getRandomItem(randomNumber);
      return `${color}-${number}`;
    }

    root.style.setProperty(
      "--color-bg-selection",
      `var(--${getRandomColor()})`,
    );
    root.style.setProperty(
      "--color-text-selection",
      `var(--${getRandomColor()})`,
    );
  }
</script>
